 "poems": [
  {
   "seq": "1",
   "text": "岩の上の松のちとせをうちかそへ年をおひつゝ君にまかせむ",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "いはまよりおひたる松の枝しけみ一葉に千代をかそへたる君",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "雲間よりほのかにみゆるあしたつのいと〓春けき聲聞ゆなり",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "天の原雲間をかけるあしたつのよはひを君にゆつる春哉",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "霞たつあしたの原をけふみれは駒放すへく野はなりにけり",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "霞たち山のふもともとめいれは春のにしきそことに見えける",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "山へにはちりや殘ると櫻花さとのにあかて尋ね來にけり",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "峯ことに咲ちる時はさくら花やまさむからぬ春の白雪",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "鏡山はこれの山にいりてこそなへての人に影もうつさめ",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "塵つもる名のみなるらし鏡山やまとなるまて曇らさりけり",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "いつかたに浪よせつらむ島かくれほのかにみゆるあまの釣舟",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "釣舟にのりてよをのみふる人のいをたにねてやあかしかぬ覽",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "あし曳のふかきみ山の花の色は見るにつけてそ里は戀しき",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あし引の山のかひより立ちぬれは殘りの雪そふかく見えける",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "枝よはみみたれやすなる靑柳の糸のたよりに風なよりこそ",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "谷河のふきあげにたてるたか柳えたのいとまもみえぬ春かな",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "風さむみ谷にこもれる鶯のうちとげてなく聲の聞えぬ",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "春といへと山かくれなる鶯はまほにそ聲も聞えさりける",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "逢見しをやがてよくやと思ひしに夢路をとらぬうつゝえけり",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "思ひやる心た〓ちにかよへともねし夜の夢にをとりぬるかな",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
